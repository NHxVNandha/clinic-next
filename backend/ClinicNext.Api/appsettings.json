{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=clinic_next;Username=postgres;Password=postgres"
  },
  "AllowedOrigins": [
    "http://localhost:5173",
    "https://clinicnext-tqti.vercel.app"
  ],
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "ClinicNext",
    "Audience": "ClinicNext.Client",
    "Key": "ChangeThisToAStrongSecretKeyWithAtLeast32Characters",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
